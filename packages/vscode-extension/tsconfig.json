{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "out",
    "module": "commonjs",
    "jsx": "react-jsx",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "har-viewer": ["../har-viewer/dist/HarViewer.d.ts"],
      "har-viewer/communication/CommunicationProvider": ["../har-viewer/dist/communication/CommunicationProvider.d.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".vscode-test",
    "out"
  ]
}