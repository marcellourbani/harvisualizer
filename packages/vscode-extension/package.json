{
  "name": "harvisualizer-vscode-extension",
  "displayName": "HAR Visualizer",
  "description": "VSCode extension for viewing and analyzing HAR files.",
  "version": "1.0.0",
  "publisher": "murbani",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcellourbani/harvisualizer.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "types": "./types/index.d.ts",
  "scripts": {
    "vscode:prepublish": "npm run build",
    "watch": "npm i;node esbuild.config.js --watch",
    "build": "node esbuild.config.js --prod",
    "compile": "tsc -p ./",
    "watch-ts": "tsc -watch -p ./"
  },
  "keywords": [],
  "activationEvents": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "har-parser": "file:../har-parser",
    "har-viewer": "file:../har-viewer"
  },
  "private": true,
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.19.5",
    "@vscode/test-electron": "^2.3.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0"
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "harvisualizer.harViewer",
        "displayName": "HAR Viewer",
        "selector": [
          {
            "filenamePattern": "*.har"
          }
        ],
        "priority": "default"
      }
    ]
  }
}